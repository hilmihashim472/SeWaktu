# Port the Express server listens on
PORT=3000

# Allowed CORS origin for the frontend
FRONTEND_ORIGIN=http://localhost:5173

# Public URL of the site, used for canonical/share links, robots.txt and
# sitemap.xml. Falls back to the request's host if unset.
# SITE_URL=https://sewaktu.example.com

# Number of reverse proxies in front of the app, so rate limiting sees the real
# client IP. Coolify = 1; Coolify behind Cloudflare's proxy = 2.
# TRUST_PROXY=1

# Per-IP request limit for /api (per minute).
# RATE_LIMIT_PER_MINUTE=300

# Timeout (ms) for outbound requests to JAKIM / Aladhan APIs
REQUEST_TIMEOUT_MS=8000

# Shared secret required in the X-Admin-Token header to call
# POST /api/admin/sync-masjid-data
ADMIN_SYNC_TOKEN=change-me

# Optional: absolute path for the masjid SQLite file. Defaults to src/db/masjid.sqlite3.
# Set this to a mounted persistent-volume path in production (e.g. on Render), since
# the app code itself is redeployed fresh on every deploy.
# DATABASE_PATH=/var/data/masjid.sqlite3

# Mosques module (OpenStreetMap data, separate from the masjid feature above).
# Supabase Postgres connection string — from your Supabase project:
# Settings -> Database -> Connection string (URI). Either the direct
# connection (port 5432) or the pooled one (port 6543) works.
# After setting this, run: npm run migrate-mosques
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional: override the Overpass API endpoint used by `npm run import-mosques`,
# e.g. to point at a mirror if overpass-api.de is rate-limiting you.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_MS=180000

# Optional: settings for `npm run geocode-mosques` (geocodes the sqlite masjid
# dataset via Nominatim). Nominatim's usage policy requires a real identifying
# User-Agent and caps public use at 1 request/second — only change
# NOMINATIM_DELAY_MS if you're running your own Nominatim instance.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_DELAY_MS=1100
# NOMINATIM_USER_AGENT=YourApp/1.0 (contact: you@example.com)
